# buckconfig for projects that use prelude//platforms:default, pointing them
# at the local harness (run.sh). Pass it with `--config-file` or copy it to the
# project's .buckconfig.local.

[buck2_re_client]
engine_address = grpc://127.0.0.1:50051
action_cache_address = grpc://127.0.0.1:50051
cas_address = grpc://127.0.0.1:50051
tls = false
instance_name = main

[buck2]
# NativeLink supports SHA256 (not buck2's default, SHA1).
digest_algorithms = SHA256

[execution_platform]
remote_enabled = true
# Must match the worker (nativelink.json5, NL_IMAGE in run.sh).
remote_execution_properties = OSFamily=linux container-image=mirror.gcr.io/library/python:3.12-slim-bookworm
